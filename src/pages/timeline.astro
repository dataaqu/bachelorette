---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <div class="wrap">
    <main class="page">
      <div class="arch-wrap">
        <img
          class="arch"
          src="/arch.png"
          alt=""
          width="800"
          height="1000"
          loading="eager"
          decoding="async"
        />

        <div class="arch-text">
          <span class="text-line text-line--first">LAST TOAST ON</span>
          <h2 class="text-line text-line--script">
            The Coast<img class="champ" src="/champ.png" alt="" width="200" height="200" />
          </h2>
          <span class="text-line text-line--last">OF IBIZA</span>
        </div>

        <div class="columns">
          <img class="column-layer layer-1" src="/1.png" alt="" width="600" height="600" loading="eager" decoding="async" />
          <img class="column-layer layer-3" src="/3.png" alt="" width="600" height="600" loading="eager" decoding="async" />
          <img class="column-layer layer-2" src="/2.png" alt="" width="600" height="600" loading="eager" decoding="async" />
          <img class="column-layer layer-4" src="/glass.png" alt="" width="200" height="200" loading="eager" decoding="async" />
        </div>
      </div>

      <!-- მეორე გვერდის შიგთავსი -->

      <section class="timeline-row">
        <img class="timeline-deco" src="/left.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
        <h2 class="timeline-title">Timeline</h2>
        <img class="timeline-deco" src="/right.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
      </section>

      <nav class="days-row" aria-label="Days" role="tablist">
        <button type="button" class="day-card is-active" data-day="1" role="tab" aria-controls="day-panel-1" aria-selected="true">
          <span class="day-label-wrap">
            <span class="day-label">Day 1</span>
            <img class="day-indicator" src="/glass.png" alt="" width="200" height="200" loading="lazy" decoding="async" aria-hidden="true" />
          </span>
          <img class="day-sun" src="/sun.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
        </button>
        <button type="button" class="day-card" data-day="2" role="tab" aria-controls="day-panel-2" aria-selected="false">
          <span class="day-label-wrap">
            <span class="day-label">Day 2</span>
            <img class="day-indicator" src="/glass.png" alt="" width="200" height="200" loading="lazy" decoding="async" aria-hidden="true" />
          </span>
          <img class="day-sun" src="/sun.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
        </button>
        <button type="button" class="day-card" data-day="3" role="tab" aria-controls="day-panel-3" aria-selected="false">
          <span class="day-label-wrap">
            <span class="day-label">Day 3</span>
            <img class="day-indicator" src="/glass.png" alt="" width="200" height="200" loading="lazy" decoding="async" aria-hidden="true" />
          </span>
          <img class="day-sun" src="/sun.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
        </button>
      </nav>

      <section class="day-panels">
        <article class="day-panel is-active" id="day-panel-1" role="tabpanel" data-day="1" aria-labelledby="day-tab-1" style="animation-delay: 5.5s;">
          <div class="event-grid">
            <div class="event-card">
              <img class="event-image" src="/day1-1.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
              <h4 class="event-title">Arrive at Hotel</h4>
              <p class="event-time">9:00 PM</p>
            </div>
            <div class="event-card">
              <img class="event-image" src="/day1-2.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
              <h4 class="event-title">Welcome Drinks</h4>
              <p class="event-time">10:00 PM</p>
            </div>
          </div>
        </article>
        <article class="day-panel" id="day-panel-2" role="tabpanel" data-day="2" aria-labelledby="day-tab-2" hidden>
          <div class="event-grid">
            <div class="event-card">
              <img class="event-image" src="/day2-1.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
              <h4 class="event-title">Breakfast at</h4>
              <p class="event-time">9:00 AM</p>
            </div>
            <div class="event-card">
              <img class="event-image" src="/day2-2.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
              <h4 class="event-title">Beach Clubs at</h4>
              <p class="event-time">10:00 AM</p>
            </div>
            <div class="event-card">
              <img class="event-image" src="/day2-3.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
              <h4 class="event-title">Dinner at Sunset</h4>
              <p class="event-time">20:00 PM</p>
            </div>
            <div class="event-card">
              <img class="event-image" src="/day2-4.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
              <h4 class="event-title">Drinks at</h4>
              <p class="event-time">23:00 PM</p>
            </div>
            <div class="event-card">
              <img class="event-image" src="/day2-5.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
              <h4 class="event-title">Club Hi Ibiza at</h4>
              <p class="event-time">12:30 AM</p>
            </div>
          </div>
        </article>
        <article class="day-panel" id="day-panel-3" role="tabpanel" data-day="3" aria-labelledby="day-tab-3" hidden>
          <div class="event-grid">
            <div class="event-card">
              <img class="event-image" src="/day3-1.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
              <h4 class="event-title">Breakfast at</h4>
              <p class="event-time">9:00 AM</p>
            </div>
            <div class="event-card">
              <img class="event-image" src="/day3-2.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
              <h4 class="event-title">Beach Clubs at</h4>
              <p class="event-time">10:00 AM</p>
            </div>
            <div class="event-card">
              <img class="event-image" src="/day3-3.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
              <h4 class="event-title">Dinner at Sunset</h4>
              <p class="event-time">20:00 PM</p>
            </div>
            <div class="event-card">
              <img class="event-image" src="/day3-4.png" alt="" width="200" height="200" loading="lazy" decoding="async" />
              <h4 class="event-title">Walk through Old Town</h4>
              <p class="event-time">22:00 PM</p>
            </div>
          </div>
        </article>
      </section>
    </main>

    <footer class="cover" aria-hidden="true"></footer>
  </div>

  <style>
    .wrap {
      min-height: 100svh;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background: var(--bg);
    }

    .page {
      flex: 1 1 auto;
    }

    .arch-wrap {
      position: relative;
      width: 80%;
      max-width: min(550px, 48vh);
      margin: 0 auto;
      container-type: inline-size;
    }

    .arch-text {
      position: absolute;
      top: 18%;             /* ← ვერტიკალური პოზიცია (ცვალე) */
      left: 50%;
      transform: translateX(-50%);
      width: 78%;           /* ← სიგანე arch-wrap-ის % */
      text-align: center;
      z-index: 5;
      pointer-events: none;
      color: var(--ink);
        
    }

    .text-line {
      margin: 0;
      line-height: 1;
    }

    .text-line--first {
      display: inline-block;
      font-family: var(--font-sans);
      font-weight: 800;
      font-size: clamp(0.63rem, 4cqi, 1.35rem);
      letter-spacing: 0.05em;
      margin-top: 10px;
      
    }

    .text-line--last {
      display: inline-block;
      font-family: var(--font-sans);
      font-weight: 800;
      font-size: clamp(0.56rem, 4cqi, 1.35rem);
      letter-spacing: 0.05em;
      transform: translate(50px, -25px);  
    }

    .text-line--script {
      font-family: var(--font-script);
      font-weight: 700;
      font-style: italic;
      font-size: clamp(2.07rem, 14.4cqi, 4.95rem);
      margin: 0.05em 0;
      letter-spacing: -0.01em;
      transform: translateX( 5px);

    }

    .champ {
      display: inline-block;
      width: 1.45em;      
      height: auto;
      vertical-align: middle;
      transform: translate(10px, -20px);
      margin-left: -0.15em;
      
    }

    @media (min-width: 768px) {
      .arch-wrap {
        width: 100%;
      }
    }

    .arch {
      display: block;
      width: 100%;
      height: auto;
    }

    .columns {
      position: absolute;
      top: 60%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 45.5%;
      aspect-ratio: 1 / 1;
      z-index: 2;

    }

    .column-layer {
      position: absolute;
      object-fit: contain;
      display: block;
    }

    

    .layer-1 {
      z-index: 2;        /* ქვედა layer */
      top: -5px;
      left: -50px;
      width: 100%;
      height: 100%;
    }

    .layer-3 {
      z-index: 1;        /* შუა layer */
      top: 25px;
      left: 60px;
      width: 85%;
      height: 85%;
    }

    .layer-2 {
      z-index: 3;        /* ზედა layer */
      top: 60px;
      left: 5px;
      width: 100%;
      height: 100%;
      transform: scale(1.05);    /* ← ვიზუალური გადიდება: 1 = ნორმალი, 1.2 = 120%, 0.8 = 80% */
      transform-origin: center;
    }

    .layer-4 {
      z-index: 4;        /* ყველაზე ზედა, layer-2-ის ზევით */
      top: 10px;         /* ← layer-2-ის ზედა ნაწილში */
      left: 50%;
      width: 33%;        /* ← პატარა ზომა */
      height: 33%;
      transform: translateX(-30%);   /* ჰორიზონტალურად ცენტრი */
    }

    /* მობილურზე layer-1 და layer-3 ცენტრისკენ (layer-2-ისკენ) 10px-ით */
    @media (max-width: 767px) {
      .layer-1 {
        left: -40px;
      }
      .layer-3 {
        left: 50px;
      }
    }

    .cover {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
      aspect-ratio: 4 / 1;
      background-image: url('/cover.png');
      background-size: cover;
      background-position: bottom center;
      background-repeat: no-repeat;
      opacity: 0;
      transform: translateY(50px);
      transition:
        opacity 1s cubic-bezier(0.22, 1, 0.36, 1),
        transform 1s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .cover.is-revealed {
      opacity: 1;
      transform: translateY(0);
    }

    .timeline-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: clamp(0.5rem, 2vw, 1.5rem);
      max-width: 600px;
      margin: 0.25rem auto 0.75rem;         /* ← bottom margin გაანახევრდა (1.5rem → 0.75rem) */
      padding: 0 clamp(1rem, 3vw, 2rem);
    }

    @media (max-width: 767px) {
      .timeline-row {
        width: 100%;
        max-width: 100%;
      }
    }

    .timeline-deco {
      width: clamp(110px, 22vw, 200px);    /* ← მობილური + ტაბლეტი (default — დიდი) */
      height: auto;
      flex-shrink: 0;
      user-select: none;
      -webkit-user-drag: none;
    }

    @media (min-width: 1024px) {
      .timeline-deco {
        width: clamp(60px, 14vw, 130px);   /* ← desktop only — პატარა */
      }
    }

    .days-row {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      gap: clamp(0.5rem, 2.5vw, 1.5rem);    /* ← −50% (იყო 1–3rem) */
      max-width: 600px;
      margin: -20px auto clamp(2rem, 6vw, 4rem);    /* ← top -20px (ზემოთ აწევა) */
      padding: 0 clamp(1rem, 3vw, 2rem);
    }

    .day-card {
      position: relative;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 0.45rem;
      text-decoration: none;
      color: var(--ink);
      cursor: pointer;
      padding: 0.5rem 0.25rem;
      border: 0;
      background: transparent;
      border-radius: 0.5rem;
      font-family: inherit;
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .day-label-wrap {
      position: relative;
      display: inline-flex;
      align-items: center;
    }

    .day-indicator {
      position: absolute;
      top: 100%;                /* ← უშუალოდ ტექსტის ქვემოთ */
      left: 50%;                /* ← ცენტრი ტექსტის (label-wrap-ის) მიმართ */
      width: 34px;              /* ← გაიზარდა (იყო 28px) */
      height: auto;
      pointer-events: none;
      opacity: 0;
      transform: translateX(-50%) translateY(-4px) scale(0.5);
      transition:
        opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .day-card.is-active .day-indicator {
      opacity: 1;
      transform: translateX(-50%) translateY(0) scale(1);
    }

    .day-card.is-active .day-label {
      color: var(--ink);
    }

    .day-card:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 4px;
    }

    .day-sun {
      width: clamp(27px, 6.3vw, 50px);      /* ← +50% (იყო 18–33px) */
      height: auto;
      display: block;
      transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
      user-select: none;
      -webkit-user-drag: none;
    }

    .day-card:hover .day-sun,
    .day-card:focus-visible .day-sun {
      transform: rotate(60deg);
    }

    .day-label {
      font-family: var(--font-sans);
      font-weight: 500;
      font-size: 15px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink);
      text-align: center;
      white-space: nowrap;
    }

    .day-panels {
      max-width: 600px;
      margin: 1rem auto 0;
      padding: 0 clamp(1rem, 4vw, 2rem);
      min-height: 8rem;
      position: relative;
    }

    .day-panel {
      text-align: center;
      color: var(--ink);
    }

    .day-panel[hidden] {
      display: none;
    }

    .day-panel.is-active {
      animation: panelIn 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @keyframes panelIn {
      0% {
        opacity: 0;
        transform: translateY(20px) scale(0.98);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .day-panel-title {
      font-family: var(--font-script);
      font-weight: 700;
      font-style: italic;
      font-size: clamp(1.6rem, 5vw, 2.8rem);
      line-height: 1.1;
      margin: 0 0 0.5rem;
      color: var(--ink);
    }

    .day-panel-text {
      font-family: var(--font-sans);
      font-weight: 500;
      font-size: clamp(0.9rem, 2vw, 1.05rem);
      line-height: 1.55;
      color: var(--ink);
      opacity: 0.85;
      margin: 0 auto;
      max-width: 36rem;
    }

    .event-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(1rem, 4vw, 2.5rem);
      max-width: 600px;
      margin: 0 auto;
      padding: 0 clamp(0.5rem, 2vw, 1rem);
    }

    .event-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.6rem;
    }

    /* მარტოხელა ბოლო card-ი (კენტი რაოდენობის შემთხვევაში) ცენტრში */
    .event-card:last-child:nth-child(odd):not(:first-child) {
      grid-column: 1 / -1;
      justify-self: center;
      max-width: 50%;
    }

    .event-image {
      width: clamp(90px, 22vw, 170px);
      height: auto;
      display: block;
      user-select: none;
      -webkit-user-drag: none;
    }

    .event-title {
      font-family: var(--font-sans);
      font-weight: 500;
      font-size: clamp(0.92rem, 2.6vw, 1.15rem);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--ink);
      margin: 0.4rem 0 0;
      line-height: 1.25;
    }

    .event-time {
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: clamp(0.85rem, 2.2vw, 1rem);
      letter-spacing: 0.04em;
      color: var(--ink);
      opacity: 0.75;
      margin: 0;
    }

    @media (max-width: 767px) {
      .days-row {
        margin-top: -40px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .day-panel.is-active {
        animation: none;
      }
      .day-indicator {
        transition: none;
      }
      .day-sun {
        transition: none;
      }
      .day-card:hover .day-sun,
      .day-card:focus-visible .day-sun {
        transform: none;
      }
    }

    .timeline-title {
      font-family: var(--font-script);
      font-weight: 700;
      font-style: italic;
      font-size: clamp(1.2rem, 9vw, 3.25rem);   
      line-height: 1;
      margin: 0;
      letter-spacing: -0.01em;
      color: var(--ink);
      white-space: nowrap;
    }

    /* ═══════════════════════════════════════════════
       LOAD ANIMATIONS
       Sequence: arch → cover → texts+champ → layers 1/2/3 → glass
       ─────────────────────────────────────────────── */

    .arch {
      animation: archIn 1s cubic-bezier(0.22, 1, 0.36, 1) 0.05s both;
    }

    /* .cover load animation removed — now scroll-triggered (see IntersectionObserver in script) */

    .text-line--first {
      animation: textTopIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) 1.55s both;
    }

    .text-line--script {
      animation: scriptIn 0.75s cubic-bezier(0.22, 1, 0.36, 1) 1.75s both;
    }

    .champ {
      animation: champIn 0.85s cubic-bezier(0.34, 1.56, 0.64, 1) 2s both;
    }

    .text-line--last {
      animation: textBottomIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) 2.1s both;
    }

    .layer-1 {
      animation: layerIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) 2.6s both;
    }

    .layer-3 {
      animation: layerIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) 2.75s both;
    }

    .layer-2 {
      animation: layer2In 0.75s cubic-bezier(0.22, 1, 0.36, 1) 2.9s both;
    }

    .layer-4 {
      animation: glassIn 0.95s cubic-bezier(0.34, 1.56, 0.64, 1) 3.4s both;
    }

    @keyframes archIn {
      0% {
        opacity: 0;
        transform: scale(0.96);
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }

    @keyframes coverIn {
      0% {
        opacity: 0;
        transform: translateY(36px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes textTopIn {
      0% {
        opacity: 0;
        transform: translateY(-14px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes scriptIn {
      0% {
        opacity: 0;
        transform: translateX(5px) translateY(-12px) scale(0.96);
      }
      100% {
        opacity: 1;
        transform: translateX(5px);
      }
    }

    @keyframes champIn {
      0% {
        opacity: 0;
        transform: translate(10px, -20px) scale(0.4) rotate(-25deg);
      }
      100% {
        opacity: 1;
        transform: translate(10px, -20px) scale(1) rotate(0deg);
      }
    }

    @keyframes textBottomIn {
      0% {
        opacity: 0;
        transform: translate(50px, -10px);
      }
      100% {
        opacity: 1;
        transform: translate(50px, -25px);
      }
    }

    @keyframes layerIn {
      0% {
        opacity: 0;
        transform: translateY(24px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes layer2In {
      0% {
        opacity: 0;
        transform: scale(0.88);
      }
      100% {
        opacity: 1;
        transform: scale(1.05);
      }
    }

    @keyframes glassIn {
      0% {
        opacity: 0;
        transform: translateX(-30%) translateY(-18px) scale(0.45) rotate(-30deg);
      }
      100% {
        opacity: 1;
        transform: translateX(-30%) scale(1) rotate(0deg);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .arch,
      .cover,
      .text-line--first,
      .text-line--script,
      .champ,
      .text-line--last,
      .layer-1,
      .layer-2,
      .layer-3,
      .layer-4,
      .timeline-deco,
      .timeline-title,
      .day-card {
        animation: none !important;
        opacity: 1 !important;
      }
      .cover {
        transform: none !important;
        transition: none !important;
      }
    }

    /* ═══════════════════════════════════════════════
       TIMELINE + DAYS LOAD ANIMATIONS
       Sequence: timeline-row → days-row → day-1 panel
       ─────────────────────────────────────────────── */

    .timeline-row > .timeline-deco:first-child {
      animation: decoLeftIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) 4.4s both;
    }

    .timeline-title {
      animation: titleIn 0.75s cubic-bezier(0.22, 1, 0.36, 1) 4.55s both;
    }

    .timeline-row > .timeline-deco:last-child {
      animation: decoRightIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) 4.55s both;
    }

    .day-card {
      opacity: 0;
      animation: dayCardIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .day-card:nth-child(1) { animation-delay: 5.0s; }
    .day-card:nth-child(2) { animation-delay: 5.1s; }
    .day-card:nth-child(3) { animation-delay: 5.2s; }

    @keyframes decoLeftIn {
      from {
        opacity: 0;
        transform: translateX(-32px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes decoRightIn {
      from {
        opacity: 0;
        transform: translateX(32px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes titleIn {
      from {
        opacity: 0;
        transform: scale(0.92);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @keyframes dayCardIn {
      from {
        opacity: 0;
        transform: translateY(22px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <script>
    const cards = document.querySelectorAll<HTMLButtonElement>('.day-card');
    const panels = document.querySelectorAll<HTMLElement>('.day-panel');
    let initialDelayCleared = false;

    function smoothScrollTo(targetY: number, duration = 800) {
      const startY = window.scrollY;
      const distance = targetY - startY;
      if (Math.abs(distance) < 4) return;
      const startTime = performance.now();
      const ease = (t: number) =>
        t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

      function step(now: number) {
        const elapsed = now - startTime;
        const t = Math.min(elapsed / duration, 1);
        window.scrollTo(0, startY + distance * ease(t));
        if (t < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    function scrollToActivePanel() {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const daysRow = document.querySelector<HTMLElement>('.days-row');
      if (!daysRow) return;
      const rect = daysRow.getBoundingClientRect();
      const offset = 24;
      const targetY = window.scrollY + rect.top - offset;
      if (reduce) {
        window.scrollTo(0, targetY);
      } else {
        smoothScrollTo(targetY, 850);
      }
    }

    // Scroll-triggered reveal for footer cover
    const cover = document.querySelector<HTMLElement>('.cover');
    if (cover && 'IntersectionObserver' in window) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) {
        cover.classList.add('is-revealed');
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                cover.classList.add('is-revealed');
                observer.unobserve(cover);
              }
            });
          },
          { threshold: 0.2, rootMargin: '0px 0px -10% 0px' },
        );
        observer.observe(cover);
      }
    } else if (cover) {
      cover.classList.add('is-revealed');
    }

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const day = card.dataset.day;
        if (!day) return;

        // Clear initial reveal delay on first interaction
        if (!initialDelayCleared) {
          panels.forEach((p) => {
            p.style.animationDelay = '';
          });
          initialDelayCleared = true;
        }

        cards.forEach((c) => {
          const isActive = c.dataset.day === day;
          c.classList.toggle('is-active', isActive);
          c.setAttribute('aria-selected', String(isActive));
        });

        panels.forEach((p) => {
          const isActive = p.dataset.day === day;
          if (isActive) {
            p.removeAttribute('hidden');
            p.classList.remove('is-active');
            void p.offsetWidth;
            p.classList.add('is-active');
          } else {
            p.classList.remove('is-active');
            p.setAttribute('hidden', '');
          }
        });

        // Smooth scroll so days-row sits near top, panel below is fully visible
        requestAnimationFrame(() => {
          scrollToActivePanel();
        });
      });
    });
  </script>
</BaseLayout>
